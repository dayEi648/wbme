# WBME 生产环境变量模板——机密不进入 Git/镜像/Compose 展开输出；复制为 .env.production 使用
# 所有机密在下方标注 [机密]；未标注项为公开部署参数

# ---- 版本与镜像 ----
# 发布 tag（与 git tag 一致；由 release.sh 传入，正常无需手改）
WBME_TAG=local

# ---- PostgreSQL（[机密] 密码）----
DATABASE_URL=postgresql://wbme:change-me@postgres:5432/wbme
POSTGRES_USER=wbme
POSTGRES_DB=wbme
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- 内部 REST（[机密] 高熵令牌，全平台共享）----
INTERNAL_SERVICE_TOKEN=change-me-at-least-32-characters

# ---- Cookie 会话（[机密] 签名密钥）与站点 ----
COOKIE_SIGNING_KEY=change-me-at-least-32-characters
COOKIE_SECURE=true
# 浏览器访问公网入口的完整 origin（如 https://wbme.example.com 或 http://ECS公网IP）
PUBLIC_ORIGIN=http://127.0.0.1

# ---- 钉钉 OAuth（[机密]）----
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me
DINGTALK_CORP_ID=change-me
DINGTALK_REDIRECT_URI=http://127.0.0.1/api/v1/auth/dingtalk/callback

# ---- 阿里云 OSS ----
# 生产使用 ECS 实例 RAM 角色（不填 AK/SK）；多角色实例需显式指定 OSS_RAM_ROLE_NAME；开发环境才使用 AK/SK
OSS_BUCKET=wbme-prod
OSS_REGION=oss-cn-hangzhou
OSS_RAM_ROLE_NAME=
# 对象键前缀（默认 images//backups/，自动补尾部斜杠；worker 清理与备份路径均读取）
OSS_PREFIX_IMAGES=images
OSS_PREFIX_BACKUPS=backups

# ---- 迁移前备份 ----
# 经全平台共享 INTERNAL_SERVICE_TOKEN 调用内部接口；PRE_MIGRATION_BACKUP_CMD 保留为命令行逃生通道

# ---- 可配置限流（主 PRD §9.7；RATE_LIMIT_<PREFIX>_LIMIT/_WINDOW_SECONDS 覆盖端点默认值）----
# 例：me 操作日志导出 20 次/小时；operation-log/system-log/approval 导出同类
# RATE_LIMIT_ME_EXPORT_LIMIT=20
# RATE_LIMIT_ME_EXPORT_WINDOW_SECONDS=3600

# ---- 恢复执行器（[机密] 控制会话密钥）----
RECOVERY_EXECUTOR_PORT=3090
RECOVERY_SESSION_SECRET=change-me-at-least-32-characters

# ---- 健康状态页磁盘预警阈值（部署安全常量，0~1）----
HEALTH_DISK_USAGE_RATIO=0.85
