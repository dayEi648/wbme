# WBME 生产环境变量模板——机密不进入 Git/镜像/Compose 展开输出；复制为 .env.production 使用
# 所有机密在下方标注 [机密]；未标注项为公开部署参数

# ---- 版本与镜像 ----
# 发布 tag（与 git tag 一致；由 release.sh 传入，正常无需手改）
WBME_TAG=local

# ---- PostgreSQL（[机密] 密码）----
DATABASE_URL=postgresql://wbme:change-me@postgres:5432/wbme
POSTGRES_USER=wbme
POSTGRES_DB=wbme
POSTGRES_PASSWORD=change-me

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- 内部 REST（[机密] 高熵令牌，全平台共享）----
INTERNAL_SERVICE_TOKEN=change-me-at-least-32-characters

# ---- Cookie 会话（[机密] 签名密钥）与站点 ----
COOKIE_SIGNING_KEY=change-me-at-least-32-characters
# 会话 Cookie Secure 属性（主 PRD §9.14）：生产保持 true。
# 现状：Nginx 已实现 80→443 强制 308 跳转，纯内网 HTTP 部署不可用——80 仅剩健康探针
# 直答，业务流量必须 HTTPS；COOKIE_SECURE=false 仅限开发环境或特殊前置代理
# （TLS 终止于上游可信链路）场景显式使用。
COOKIE_SECURE=true
# 浏览器访问公网入口的完整 origin（HTTPS 生产入口，如 https://wbme.example.com）
PUBLIC_ORIGIN=https://wbme.example.com

# ---- TLS 证书（HTTPS，主 PRD §9.14）----
# 部署前将 fullchain.pem / privkey.pem 放置到 /opt/wbme/tls/（TLS_CERT_DIR 可覆盖），
# 由 web 容器只读挂载到 /etc/nginx/certs；未放置证书时 Nginx 443 无法启动。
# TLS_CERT_DIR=/opt/wbme/tls

# ---- 钉钉 OAuth（[机密]）----
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me
DINGTALK_CORP_ID=change-me
DINGTALK_REDIRECT_URI=https://wbme.example.com/api/v1/auth/dingtalk/callback

# ---- 阿里云 OSS ----
# 生产使用 ECS 实例 RAM 角色（不填 AK/SK）；多角色实例需显式指定 OSS_RAM_ROLE_NAME；开发环境才使用 AK/SK
OSS_BUCKET=wbme-prod
OSS_REGION=oss-cn-hangzhou
OSS_RAM_ROLE_NAME=
# 对象键前缀（默认 images//backups/，自动补尾部斜杠；worker 清理与备份路径均读取）
OSS_PREFIX_IMAGES=images
OSS_PREFIX_BACKUPS=backups

# ---- 迁移前备份 ----
# 经全平台共享 INTERNAL_SERVICE_TOKEN 调用内部接口；PRE_MIGRATION_BACKUP_CMD 保留为命令行逃生通道

# ---- 可配置限流（主 PRD §9.7；RATE_LIMIT_<PREFIX>_LIMIT/_WINDOW_SECONDS 覆盖端点默认值）----
# 例：me 操作日志导出 20 次/小时；operation-log/system-log/approval 导出同类
# RATE_LIMIT_ME_EXPORT_LIMIT=20
# RATE_LIMIT_ME_EXPORT_WINDOW_SECONDS=3600

# ---- 恢复执行器（[机密] 控制会话密钥）----
RECOVERY_EXECUTOR_PORT=3090
RECOVERY_SESSION_SECRET=change-me-at-least-32-characters

# ---- 健康状态（部署安全常量；主 PRD §9.13）----
# 由恢复执行器在 Compose 内固定测量 PostgreSQL/Redis 数据卷与恢复持久化目录；
# 无需也不得把数据卷挂入业务容器。以下仅配置统一预警/严重阈值。
# 预警/严重阈值（使用率 0~1）；达严重时停止接受上传/导入/备份
HEALTH_DISK_WARN_RATIO=0.8
HEALTH_DISK_CRITICAL_RATIO=0.9
# 业务服务探针（注入 platform-core）
# ASSET_HEALTH_URL=http://asset:3002
# HR_HEALTH_URL=http://hr:3003
# FIN_HEALTH_URL=http://fin:3004
