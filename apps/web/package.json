{
  "name": "@wbme/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WBME 前端：Vite + React + Ant Design（主 PRD §10）",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
