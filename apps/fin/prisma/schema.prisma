// fin 部署单元 Prisma 配置（主 PRD §9.9）
//
// multi-file schema：fin.prisma（fin 模块全部模型，9 张表）
// 单 schema：fin，单一 Prisma Client、单一迁移序列；模型通过 @@schema 声明归属。
// 独立服务不建跨 schema 外键：跨模块引用（用户 ID、字典 ID 等）只存 Int 字段。
//
// 表设计中的部分唯一索引已在模型 @@unique(where: ...) 声明（partialIndexes preview），
// 防止未来 migrate diff 误删；CHECK 约束等其余 PostgreSQL 专属能力仍由迁移 SQL 手动补充。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["fin"]
}
