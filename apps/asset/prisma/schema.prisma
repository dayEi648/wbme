// asset 部署单元 Prisma 配置（主 PRD §9.9）
//
// multi-file schema：schema.prisma + asset.prisma（asset 模块 30 张表）
// 独立部署单元：仅 asset 一个 PostgreSQL schema，独立迁移序列；
// 模型通过 @@schema 声明归属，独立服务不建立跨 schema 外键
// （跨模块引用只存目标 ID，展示信息按快照原则存文字快照）。
//
// 表设计中的部分唯一索引已在模型 @@unique(where: ...) 声明（partialIndexes preview），
// 防止未来 migrate diff 误删；CHECK 约束等其余 PostgreSQL 专属能力仍由迁移 SQL 手动补充。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["asset"]
}
