// 6. 二维码
// ============================================================

/// A-27 qr_codes 二维码（部分唯一索引由迁移 SQL 补充）
model QrCode {
  id         Int         @id @default(autoincrement())
  publicId   String      @unique @map("public_id")
  targetType QrTargetType @map("target_type")
  targetId   Int?        @map("target_id")
  status     QrStatus    @default(ACTIVE)
  revokedAt  DateTime?   @map("revoked_at")
  createdBy  Int         @map("created_by")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedBy  Int?        @map("updated_by")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("qr_codes")
  @@schema("asset")
}

// ============================================================
// 7. 配置
// ============================================================

/// A-28 asset_settings 资产配置（backstage.md §S-8 同构，无 group/sensitive）
model AssetSetting {
  id        Int              @id @default(autoincrement())
  key       String           @unique
  value     String
  valueType SettingValueType @map("value_type")
  label     String
  updatedBy Int?             @map("updated_by")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("asset_settings")
  @@schema("asset")
}

/// A-29 operation_logs（asset schema，结构与 base.operation_logs（B-4）完全一致）
model AssetOperationLog {
  id                  Int       @id @default(autoincrement())
  operatorId          Int?      @map("operator_id")
  operatorName        String?   @map("operator_name")
  operatorDepartments Json?     @map("operator_departments")
  system              String
  feature             String
  actionType          LogAction @map("action_type")
  summary             String
  idempotencyScope    String?   @map("idempotency_scope")
  idempotencyKey      String?   @map("idempotency_key")
  requestFingerprint  String?   @map("request_fingerprint")
  resultReference     Json?     @map("result_reference")
  requestId           String?   @map("request_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([system, createdAt])
  @@index([operatorId, createdAt])
  @@map("operation_logs")
  @@schema("asset")
}

/// A-30 user_table_prefs 用户表格偏好（物理删除，结构与 base.user_table_prefs（B-5）一致）
model AssetUserTablePref {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  pageKey   String        @map("page_key")
  prefType  TablePrefType @map("pref_type")
  name      String?
  content   Json
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([userId, pageKey])
  @@map("user_table_prefs")
  @@schema("asset")
}
