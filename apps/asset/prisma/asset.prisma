/// A-28 asset_settings 资产配置（backstage.md §S-8 同构，无 group/sensitive）
model AssetSetting {
  id        Int              @id @default(autoincrement())
  key       String           @unique
  value     String
  valueType SettingValueType @map("value_type")
  label     String
  updatedBy Int?             @map("updated_by")
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("asset_settings")
  @@schema("asset")
}

/// A-29 operation_logs（asset schema，结构与 base.operation_logs（B-4）完全一致）
model AssetOperationLog {
  id                  Int       @id @default(autoincrement())
  operatorId          Int?      @map("operator_id")
  operatorName        String?   @map("operator_name")
  operatorDepartments Json?     @map("operator_departments")
  system              String
  feature             String
  actionType          LogAction @map("action_type")
  summary             String
  idempotencyScope    String?   @map("idempotency_scope")
  idempotencyKey      String?   @map("idempotency_key")
  requestFingerprint  String?   @map("request_fingerprint")
  resultReference     Json?     @map("result_reference")
  requestId           String?   @map("request_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([system, createdAt])
  @@index([operatorId, createdAt])
  @@index([actionType, createdAt])
  @@map("operation_logs")
  @@schema("asset")
}

/// A-30 user_table_prefs 用户表格偏好（物理删除，结构与 base.user_table_prefs（B-5）一致）
model AssetUserTablePref {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  pageKey   String        @map("page_key")
  prefType  TablePrefType @map("pref_type")
  name      String?
  content   Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // 同页面同名预设唯一（A-30；索引由迁移 SQL 建立，此处声明防 migrate diff 误删）
  @@unique([userId, pageKey, name], map: "user_table_prefs_preset_unique", where: raw("pref_type = 'FILTER_PRESET'"))
  // 每页一条列设置（A-30；索引由迁移 SQL 建立，此处声明防 migrate diff 误删）
  @@unique([userId, pageKey], map: "user_table_prefs_column_unique", where: raw("pref_type = 'COLUMN_SETTING'"))
  @@map("user_table_prefs")
  @@schema("asset")
}
