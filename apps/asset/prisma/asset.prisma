// 6. 二维码
// ============================================================

/// A-27 qr_codes 二维码（部分唯一索引由迁移 SQL 补充）
model QrCode {
  id         Int          @id @default(autoincrement())
  publicId   String       @unique @map("public_id")
  targetType QrTargetType @map("target_type")
  targetId   Int?         @map("target_id")
  status     QrStatus     @default(ACTIVE)

  // 同一业务目标最多一张未作废二维码（docs/database-design/asset.md §332）。
  // 索引列含 COALESCE(target_id, 0) 表达式，Prisma 无法在 schema 表达，由迁移 SQL 管理（migrate diff 会显示该差异，属已知噪音）。
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdBy  Int          @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy  Int?         @map("updated_by")
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("qr_codes")
  @@schema("asset")
}

