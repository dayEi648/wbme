// hr 部署单元 Prisma 配置（主 PRD §9.9）
//
// multi-file schema：hr.prisma（hr 模块，H-1 ~ H-18）
// multiSchema：hr 单一 PostgreSQL schema、单一 Prisma Client、独立迁移序列；
// hr 为独立服务，不建立跨 schema 外键：跨模块引用（用户 ID）只存 Int 字段，
// 展示所需信息（姓名、部门等）按快照原则存快照字段。
//
// 表设计中的部分唯一索引已在模型 @@unique(where: ...) 声明（partialIndexes preview），
// 防止未来 migrate diff 误删；CHECK 约束等其余 PostgreSQL 专属能力仍由迁移 SQL 手动补充。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["hr"]
}
