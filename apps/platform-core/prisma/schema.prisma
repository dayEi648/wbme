// platform-core 部署单元 Prisma 配置（主 PRD §9.9）
//
// multi-file schema：base.prisma（base 模块）+ backstage.prisma（backstage 模块）
// multiSchema：base + backstage 两个 PostgreSQL schema，单一 Prisma Client、单一迁移序列；
// 模型通过 @@schema 声明归属，平台核心内允许建立跨 base/backstage 的外键。
//
// 表设计中的部分唯一索引（手机号唯一/单有效邀请/单有效绑定）已在模型 @@unique(where: ...)
// 声明，防止未来 migrate diff 误删（partialIndexes preview 特性）；
// CHECK 约束等其余 PostgreSQL 专属能力仍由初始迁移 SQL 手动补充（见 prisma/migrations/<init>/migration.sql）。

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["base", "backstage"]
}
