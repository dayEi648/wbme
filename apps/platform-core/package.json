{
  "name": "@wbme/platform-core",
  "version": "0.1.0",
  "private": true,
  "description": "WBME platform-core 部署单元：base + backstage 逻辑模块（主 PRD §1.3）",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "nest build",
    "openapi:generate": "nest build && node dist/openapi/generate-openapi.js",
    "openapi:verify": "nest build && node dist/openapi/generate-openapi.js --check",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@node-rs/argon2": "^2.0.2",
    "@wbme/contracts": "workspace:*",
    "@wbme/logging": "workspace:*",
    "@wbme/server": "workspace:*",
    "@wbme/tasks": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.10"
  }
}
