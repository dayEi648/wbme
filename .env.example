# WBME 环境变量示例——机密一律不进入版本库；复制为 .env 使用，生产机密由部署环境注入

# --- PostgreSQL（开发库 wbme-dev / 测试库 wbme-test；各部署单元经 ?schema= 隔离）---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wbme-dev

# --- 首个超级管理员种子账号（不配置则 seed 跳过创建；直接创建为已激活账号，初始密码 8~32 位）---
SUPER_ADMIN_NAME=admin
SUPER_ADMIN_PHONE=13800138000
SUPER_ADMIN_GENDER=MALE
SUPER_ADMIN_PASSWORD=change-me-8-to-32-chars

# --- Redis（单实例）---
REDIS_URL=redis://localhost:6379

# --- 应用安全 ---
# COOKIE_SIGNING_KEY：CSRF 签名密钥（部署级机密，≥32 字符，缺失拒绝启动）
# COOKIE_SECURE：Cookie Secure 属性（生产 true，本地 http 设 false，默认 true）
COOKIE_SIGNING_KEY=change-me-at-least-32-chars
COOKIE_SECURE=false

# --- 内部服务令牌（全平台共享高熵令牌，部署注入）---
INTERNAL_SERVICE_TOKEN=change-me-high-entropy-value
# hr/asset 服务内部地址（供 platform-core 跨服务调用；开发本地回环，生产 compose 私网）
HR_INTERNAL_BASE_URL=http://localhost:43003
ASSET_INTERNAL_BASE_URL=http://localhost:43002

# --- 钉钉企业内部应用凭证（仅后端使用）---
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me
DINGTALK_AGENT_ID=change-me
DINGTALK_CORP_ID=change-me
# 钉钉 OAuth 回调地址（与钉钉开发者后台一致；默认 {PUBLIC_ORIGIN}/api/v1/auth/dingtalk/callback）
DINGTALK_REDIRECT_URI=http://localhost:45173/api/v1/auth/dingtalk/callback

# --- 阿里云 OSS（开发用静态凭证；生产用 ECS RAM 角色，不配置静态密钥）---
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
OSS_BUCKET=wbme-dev
OSS_REGION=oss-cn-hangzhou
# 生产 ECS 多角色时显式指定
OSS_RAM_ROLE_NAME=

# --- 前端公开地址（激活/重置链接与钉钉回调 origin 基准）---
PUBLIC_ORIGIN=http://localhost:45173

# --- 应用端口（开发环境本地进程；被占用时 pnpm dev 自动 +1 顺延）---
PLATFORM_CORE_PORT=43001
ASSET_PORT=43002
HR_PORT=43003
FIN_PORT=43004
WEB_PORT=45173

# --- 备份与恢复 ---
# pg 工具路径（默认走 PATH；macOS EDB 安装不在 PATH 时注入）
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore
# PSQL_PATH=psql
# 恢复执行器状态目录（外部控制清单 + 维护标记；Nginx 生产只读挂载同一目录）
# RESTORE_STATE_DIR=.agents/restore-state
# 恢复执行器内部地址（worker 投递 RESTORE_DELIVERY）
# RECOVERY_EXECUTOR_URL=http://127.0.0.1:43090
# 恢复后正向迁移命令（不配置则跳过并告警）
# RECOVERY_MIGRATE_CMD=node apps/migration-runner/dist/index.js
# 恢复控制会话 HMAC 密钥（签发 /recovery 控制 Cookie）
# RECOVERY_SESSION_SECRET=change-me-high-entropy-value
# 恢复演练时跳过 Redis 清空（默认执行 flushdb）
# RECOVERY_SKIP_REDIS_FLUSH=0
