# ============================================================
# WBME 环境变量示例 —— 机密一律不进入版本库（主 PRD §9.14）
# 复制为 .env 使用；生产机密由部署环境注入
# ============================================================

# --- PostgreSQL（本地开发；生产由部署环境注入）---
# 主 PRD §9.9：应用侧仅一个连接账号；platform-core/asset/hr/fin 复用
# 开发库 wbme-dev、测试库 wbme-test（各部署单元迁移元数据经 ?schema= 参数隔离落位）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wbme-dev

# --- 首个超级管理员种子账号（主 PRD §3.1：姓名、手机号、性别；激活后初始化入口永久关闭）---
# 请改为真实信息：手机号支持 13800138000 / +8613800138000 等写法（入库统一规范化为 +86 格式）；
# 不配置则 seed 跳过超管创建；格式非法会导致 pnpm dev 的 seed 步骤报错
SUPER_ADMIN_NAME=admin
SUPER_ADMIN_PHONE=13800138000
SUPER_ADMIN_GENDER=MALE

# --- Redis（主 PRD §9.8：单实例，持久化 + noeviction）---
REDIS_URL=redis://localhost:6379

# --- 应用安全（主 PRD §9.7：CSRF 双提交签名密钥与会话 Cookie 属性）---
# COOKIE_SIGNING_KEY：CSRF Cookie 签名密钥，部署级机密，至少 32 字符；缺失时服务拒绝启动
COOKIE_SIGNING_KEY=change-me-at-least-32-chars
# COOKIE_SECURE：会话/CSRF Cookie 的 Secure 属性。生产必须 true（默认）；
# 本地 http 开发设 false（不配置则按 true 处理）
COOKIE_SECURE=false

# --- 内部服务令牌（主 PRD §9.4：全平台共享高熵令牌，部署注入）---
INTERNAL_SERVICE_TOKEN=change-me-high-entropy-value
# hr 服务内部地址（platform-core 调 hr 生命周期接口；开发默认本地回环，生产 compose 私网 http://hr:3003）
HR_INTERNAL_BASE_URL=http://localhost:3003

# --- 钉钉企业内部应用（base PRD §2；凭证仅后端使用）---
DINGTALK_APP_KEY=change-me
DINGTALK_APP_SECRET=change-me
DINGTALK_CORP_ID=change-me
# 钉钉 OAuth 回调地址（与钉钉开发者后台配置一致，须经前端/Nginx 代理到后端 /api/v1 路由；
# 不配置时默认 {PUBLIC_ORIGIN}/api/v1/auth/dingtalk/callback）
DINGTALK_REDIRECT_URI=http://localhost:5173/api/v1/auth/dingtalk/callback

# --- 阿里云 OSS（主 PRD §9.2）---
# 开发环境：静态凭证（.env）；生产环境：ECS 实例 RAM 角色（daiyi），不配置静态密钥
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
OSS_BUCKET=wbme-dev
OSS_REGION=oss-cn-hangzhou

# --- 前端公开地址与回跳基准（base PRD §2：激活/重置/换绑链接与钉钉回调 origin）---
PUBLIC_ORIGIN=http://localhost:5173

# --- 应用端口（开发环境本地进程）---
PLATFORM_CORE_PORT=3001
ASSET_PORT=3002
HR_PORT=3003
FIN_PORT=3004
WEB_PORT=5173

# --- 认证与会话（base PRD §2/§3、主 PRD §9.7）---
# 钉钉授权回调地址：必须与钉钉开发者后台配置的回调域名一致（开发环境可内网穿透）
DINGTALK_REDIRECT_URI=http://localhost:5173/api/v1/auth/dingtalk/callback
# 前端公开地址（生成激活/重置/换绑链接与二维码的基准 origin）
PUBLIC_ORIGIN=http://localhost:5173
# CSRF 双提交 Cookie 签名密钥（部署级机密，长度 ≥ 32）
COOKIE_SIGNING_KEY=change-me-high-entropy-signing-key-32+
# 会话 Cookie Secure 属性：生产必须 true；本地 http 开发设 false
COOKIE_SECURE=false
